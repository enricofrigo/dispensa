<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dispensa_database" />
        <exclude domain="database" path="dispensa_database-shm" />
        <exclude domain="database" path="dispensa_database-wal" />
        <exclude domain="sharedpref" path="eu.frigo.dispensa_preferences.xml" />
        <exclude domain="sharedpref" path="sync_cursor_prefs.xml" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="eu.frigo.dispensa_preferences.xml" />
        <exclude domain="sharedpref" path="sync_cursor_prefs.xml" />
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
